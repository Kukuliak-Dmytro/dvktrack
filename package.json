{
  "name": "nutrition-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:db": "npx ts-node --project tsconfig.scripts.json scripts/setup-db.ts",
    "db:start": "docker compose up -d || docker-compose up -d",
    "db:stop": "docker compose down || docker-compose down",
    "db:restart": "yarn db:stop && yarn db:start",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "predev": "yarn setup:db",
    "import-ingredients": "npx ts-node --project tsconfig.scripts.json src/scripts/import-ingredients.ts",
    "import-recipes": "npx ts-node --project tsconfig.scripts.json src/scripts/add-recipe.ts",
    "import-planck": "npx ts-node --project tsconfig.scripts.json scripts/import-planck-data.ts",
    "import-all": "yarn import-ingredients && yarn import-recipes",
    "seed:db": "yarn import-all",
    "validate-data": "npx ts-node --project tsconfig.scripts.json src/scripts/validate-data.ts",
    "scrape-silpo": "npx ts-node --project tsconfig.scripts.json src/scripts/scrape-silpo.ts",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/openai-compatible": "^3.0.79",
    "@ai-sdk/react": "^4.0.158",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.17.1",
    "@prisma/extension-accelerate": "^2.0.2",
    "@prisma/extension-optimize": "^2.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.7.0",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/csv-parse": "^1.1.12",
    "add": "^2.0.6",
    "ai": "^7.0.154",
    "axios": "^1.12.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.545.0",
    "next": "15.5.4",
    "next-intl": "^4.8.1",
    "next-themes": "^0.4.6",
    "puppeteer": "^23.11.1",
    "react": "^19.1.2",
    "react-burger-menu": "^3.1.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.64.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.3.0",
    "remark-gfm": "^4.0.1",
    "select": "^1.1.2",
    "shadcn": "^3.4.2",
    "sonner": "^2.0.7",
    "supabase": "^2.45.5",
    "tailwind-merge": "^3.3.1",
    "textarea": "^0.3.0",
    "use-debounce": "^10.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/axios": "^0.9.36",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-burger-menu": "^2.8.7",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "26.1.0",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "8.0.0",
    "vitest": "^5.1.0"
  }
}
